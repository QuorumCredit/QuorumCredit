{
  "name": "quorumcredit-indexer",
  "version": "1.0.0",
  "description": "QuorumCredit Event Indexer Service",
  "main": "indexer.ts",
  "scripts": {
    "start": "ts-node indexer.ts",
    "dev": "nodemon --exec ts-node indexer.ts",
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": ["quorumcredit", "soroban", "indexer", "events"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "collectCoverageFrom": [
      "indexer.ts"
    ]
  }
}